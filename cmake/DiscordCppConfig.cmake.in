@PACKAGE_INIT@

if(@DISCORDCPP_WITH_CURL_PACKAGE@)
    include(CMakeFindDependencyMacro)
    find_dependency(CURL 7.84.0)
endif()

if(@DISCORDCPP_WITH_REST_API_PACKAGE@)
    include(CMakeFindDependencyMacro)
    find_dependency(nlohmann_json 3.12.0 CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/DiscordCppTargets.cmake")
check_required_components(DiscordCpp)
